# Reference copy of the vhosts on the VPS (/opt/caddy/vhost/budget-app, budget-app-dev and
# budget-app-admin), imported from the shared Caddy container's main Caddyfile. Caddy does not
# read this file directly. moneysight.app is proxied by Cloudflare, so TLS uses the Cloudflare
# origin certificate for moneysight.app and *.moneysight.app.

moneysight.app {
    tls /etc/ssl/cert/moneysight_app.cert.pem /etc/ssl/private/moneysight_app.key.pem

    root * /var/www/budget-app/public
    encode zstd gzip

    header /build/* Cache-Control "public, max-age=31536000, immutable"
    header /sw.js Cache-Control "no-cache"
    header /manifest.webmanifest Content-Type "application/manifest+json"

    php_fastcgi budget-app:9000 {
        root /var/www/html/public
    }
    file_server

    log {
        output file /var/log/caddy/moneysight_app.access.log {
            roll_size 50mb
            roll_keep 5
            roll_keep_for 14d
        }

        format console
    }
}

dev.moneysight.app {
    tls /etc/ssl/cert/moneysight_app.cert.pem /etc/ssl/private/moneysight_app.key.pem

    root * /var/www/budget-app-dev/public
    encode zstd gzip
    header X-Robots-Tag "noindex, nofollow"

    header /build/* Cache-Control "public, max-age=31536000, immutable"
    header /sw.js Cache-Control "no-cache"
    header /manifest.webmanifest Content-Type "application/manifest+json"

    php_fastcgi budget-app-dev:9000 {
        root /var/www/html/public
    }
    file_server

    log {
        output file /var/log/caddy/dev_moneysight_app.access.log {
            roll_size 50mb
            roll_keep 5
            roll_keep_for 14d
        }

        format console
    }
}

# Admin panel (Filament) and monitoring (Pulse) of production, served by the same container.
admin.moneysight.app {
    tls /etc/ssl/cert/moneysight_app.cert.pem /etc/ssl/private/moneysight_app.key.pem

    root * /var/www/budget-app/public
    encode zstd gzip
    header X-Robots-Tag "noindex, nofollow"
    redir / /admin

    header /build/* Cache-Control "public, max-age=31536000, immutable"
    header /sw.js Cache-Control "no-cache"
    header /manifest.webmanifest Content-Type "application/manifest+json"

    php_fastcgi budget-app:9000 {
        root /var/www/html/public
    }
    file_server

    log {
        output file /var/log/caddy/admin_moneysight_app.access.log {
            roll_size 50mb
            roll_keep 5
            roll_keep_for 14d
        }

        format console
    }
}
